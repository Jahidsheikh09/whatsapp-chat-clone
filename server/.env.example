PORT=5000

# PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/dbname

JWT_SECRET=replace_with_a_long_random_secret

# Frontend URL(s) — comma-separated. Used for CORS and OAuth redirect after login.
CLIENT_URL=http://localhost:5173

# Google OAuth (from Google Cloud Console → Credentials → OAuth Client ID)
GOOGLE_CLIENT_ID=123456789012-abcdefghijklm.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxx

# Must match "Authorized redirect URIs" in Google Cloud Console exactly
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Production example (backend on Render):
# GOOGLE_CALLBACK_URL=https://whatsapp-chat-clone.onrender.com/api/auth/google/callback
# CLIENT_URL=https://whatsapp-chat-clone.vercel.app

# Production example (single Vercel deploy — API + frontend same domain):
# GOOGLE_CALLBACK_URL=https://whatsapp-chat-clone.vercel.app/api/auth/google/callback
# CLIENT_URL=https://whatsapp-chat-clone.vercel.app
